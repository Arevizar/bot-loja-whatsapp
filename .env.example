# Copie este arquivo para ".env" e preencha com seus dados reais.
# Não suba o arquivo ".env" (com seus dados reais) para lugar nenhum público.

# Seu número pessoal, para onde o bot manda o resumo diário dos pedidos.
# Formato: código do país + DDD + número, sem espaços, símbolos ou o "+"
NUMERO_DONO=5511999999999@s.whatsapp.net

# Chave PIX que aparece no QR Code de pagamento (CPF, CNPJ, e-mail, telefone ou chave aleatória)
PIX_CHAVE=sua-chave-pix

# Nome do titular da conta (máx. 25 caracteres)
PIX_NOME_BENEFICIARIO="Seu Nome"

# Cidade do titular, sem acento (máx. 15 caracteres)
PIX_CIDADE="SAO PAULO"

# Endereço de onde saem as entregas (usado no cálculo do frete)
ENDERECO_ORIGEM="Rua Exemplo, 123 - Bairro, Cidade - UF"
